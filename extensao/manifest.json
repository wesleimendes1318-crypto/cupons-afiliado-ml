{
  "manifest_version": 3,
  "name": "Conferidor de Cupons",
  "version": "1.82.0",
  "incognito": "spanning",
  "description": "Confere o desconto real dos cupons de afiliado: teto, compra minima e validade, direto na pagina do anuncio.",
  "author": "Weslei Mendes",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.mercadolibre.com/*",
    "*://meli.la/*",
    "https://*.mlstatic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://cupons-afiliado-ml.lovable.app/*",
    "https://https-cupons-afiliado-ml.lovable.app/*",
    "https://melhorescolha.io/*",
    "https://www.melhorescolha.io/*",
    "https://rjevaqtnlldhnwsidbbn.supabase.co/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conferidor de Cupons",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png",
      "48": "icones/icone48.png",
      "128": "icones/icone128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolivre.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cupons-afiliado-ml.lovable.app/*",
        "https://https-cupons-afiliado-ml.lovable.app/*",
        "https://melhorescolha.io/*",
        "https://www.melhorescolha.io/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
