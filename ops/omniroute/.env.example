# Configuração do serviço OmniRoute, separada dos secrets do site.
# Gerar os quatro valores abaixo no próprio servidor. Não versionar os valores.
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
INITIAL_PASSWORD=
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true
APP_BIND_HOST=127.0.0.1
HOST=127.0.0.1
PORT=20128
NODE_ENV=production
